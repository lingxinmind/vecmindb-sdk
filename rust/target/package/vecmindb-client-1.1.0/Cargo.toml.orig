[package]
name = "vecmindb-client"
version = "1.1.0"
edition = "2021"
description = "VecminDB client SDK (vecmindb-client) — semantic memory for hand-rolled agents: two-line before_turn/after_turn loop over the MCP message endpoint."
license = "MIT OR Apache-2.0"
homepage = "https://lingxinmind.com"
repository = "https://github.com/lingxinmind/vecminDB"
documentation = "https://lingxinmind.com/docs"
readme = "README.md"

[dependencies]
regex = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
reqwest = { version = "0.12", default-features = false, features = ["blocking", "json", "rustls-tls"] }

[dev-dependencies]
